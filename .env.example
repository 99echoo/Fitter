# Backend (root .env)
# - Do NOT commit your real `.env` (it is gitignored).
# - Copy this file to `.env` and fill in real keys.

# Database
DATABASE_URL=postgresql://fitter:fitter_password@localhost:5432/fitter

# OpenAI (GPT-Image)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_OUTPUT_SIZE=1024x1536
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_IMAGE_QUALITY=auto
OPENAI_IMAGE_N=1

# Optional (multiple orgs/projects)
# Both names are supported:
# - OPENAI_ORG_ID / OPENAI_PROJECT_ID (docs-friendly)
# - OPENAI_ORGANIZATION / OPENAI_PROJECT (code-friendly)
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Kling AI (Image-to-Video)
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# Optional Kling settings
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL_NAME=kling-v1
KLING_MODE=pro
KLING_DURATION=5

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploads
UPLOAD_DIR=uploads

# Optional: skip DB init on startup (useful for tests)
FITTER_SKIP_DB_INIT=0
